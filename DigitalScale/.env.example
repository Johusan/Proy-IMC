# DIGITALSCALE AI - CONFIGURACION DE ENTORNO LOCAL
# Copie este archivo a .env para personalizar variables sin modificar el codigo fuente.

# Direccion IP y puerto de escucha del servidor FastAPI
DIGITALSCALE_HOST=127.0.0.1
DIGITALSCALE_PORT=8000

# Recarga automatica en caliente para desarrollo (true/false)
DIGITALSCALE_RELOAD=false

# Origenes permitidos para politicas de seguridad CORS (separados por coma)
DIGITALSCALE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
